/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN

# Vite content-hashed bundles: safe to pin for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Regenerated subsets keep the same filename, so revalidate instead of pinning.
/fonts/*
  Cache-Control: public, max-age=604800

# Editorial stock and official photography; replaced only by deliberate uploads.
/images/*
  Cache-Control: public, max-age=2592000
